# bgen code
include src/bgen/*.py
include src/bgen/*.pyi
include src/bgen/*.pyx
include src/bgen/py.typed
# cython generates these while building, so a copy here could be stale
exclude src/bgen/*.cpp
include src/*.h
include src/*.cpp
recursive-include src/zstd/lib/ *.h
recursive-include src/zstd/lib/common *.c
recursive-include src/zstd/lib/compress *.c
recursive-include src/zstd/lib/decompress *.c *.S
include src/zlib-ng/*.h
include src/zlib-ng/*.c
include src/zlib-ng/CMakeLists.txt
include src/zlib-ng/*.in
include src/zlib-ng/*.cmakein
include src/zlib-ng/*.empty
recursive-include src/zlib-ng/cmake/ *
recursive-include src/zlib-ng/arch/ *.c
recursive-include src/zlib-ng/arch/ *.h
recursive-include src/zlib-ng/arch/ *.in
